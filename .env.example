# ==============================================================================
# Clerk Authentication Configuration
# ==============================================================================
# Retrieve your keys from the Clerk Dashboard: https://dashboard.clerk.com -> API Keys
# ==============================================================================

# Clerk Publishable Key (Used by client-side ClerkJS component)
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Clerk Secret Key (Backend API access only - NEVER expose to browser/client)
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Optional: Custom Clerk Frontend API domain (e.g., your-subdomain.clerk.accounts.dev)
# If left blank, this is automatically decoded from CLERK_PUBLISHABLE_KEY
CLERK_FRONTEND_API=
